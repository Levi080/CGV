<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Advogados App</title>

    @* Referências CSS (Bootstrap) *@
    <link href="~/Content/bootstrap.min.css" rel="stylesheet" type="text/css" />
    <link href="~/Content/Site.css" rel="stylesheet" type="text/css" />
    @Styles.Render("~/Content/css")

  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer" />
     @Scripts.Render("~/bundles/modernizr")

</head>
<body>
    <div class="container body-content pt-5">
        @RenderBody()
        <hr />
        <footer class="text-center mt-5 py-3 bg-light">
            <p class="mb-0">&copy; @DateTime.Now.Year - Chalfin, Goldberg, Vainboim & Fichtner Advogados Associados</p>
        </footer>
    </div>

    @* Referências de Scripts (rodapé) *@
    <script src="~/Scripts/jquery-3.7.0.min.js"></script>

    @* Bootstrap JS *@
    <script src="~/Scripts/bootstrap.min.js"></script>
    <script src="~/Scripts/app/Advogado/AdvogadoViewModel.js"></script>

    @* jQuery Mask Plugin: Essencial para as máscaras no Formulario.cshtml *@
    <script src="~/Scripts/jquery.mask.min.js"></script>

    @* Scripts de Validação (necessário para a validação do lado do cliente) *@
    <script src="~/Scripts/jquery.validate.min.js"></script>
    <script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>

    @RenderSection("scripts", required: false)
</body>
</html>