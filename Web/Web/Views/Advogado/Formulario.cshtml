
@using Web.ViewModels;
@model AdvogadoViewModel

@{
    ViewBag.Title = "Cadastro de Advogado";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@using (Html.BeginForm("Incluir", "Advogado", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    <div class="form-horizontal">
        <div class="form-group">
            @Html.LabelFor(model => model.Cep, new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @* Adiciona a ID para que o JS possa formatar *@
                @Html.EditorFor(model => model.Cep, new { htmlAttributes = new { @class = "form-control", @id = "cep" } })
                @Html.ValidationMessageFor(model => model.Cep, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.Numero, new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @* Usa type=number para validação inicial e ID para o JS *@
                @Html.EditorFor(model => model.Numero, new { htmlAttributes = new { @class = "form-control", @id = "numero", type = "number" } })
                @Html.ValidationMessageFor(model => model.Numero, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            <div class="col-md-offset-2 col-md-10">
                <input type="submit" value="Salvar" class="btn btn-default" />
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        // Chama a função de carregamento do JS
        AdvogadoViewModel_AoCarregarComponente();
        AdvogadoViewModel_FormatarCampos(); // Chama a função de formatação
    </script>
}
