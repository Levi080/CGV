@model List<AdvogadoViewModel>

@{
    ViewBag.Title = "Lista de Advogados";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-3">

    <h3>Lista de Advogados</h3>

    <button type="button" class="btn btn-primary" id="btnNovoAdvogado">
        Adicionar Novo Advogado
    </button>
</div>

<hr />

<table class="table table-striped mt-4" id="tabelaAdvogados">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.First().Nome)</th>
            <th>@Html.DisplayNameFor(model => model.First().Senioridade)</th>
            <th>@Html.DisplayNameFor(model => model.First().Estado)</th>
            <th>Ações</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var advogado in Model)
        {
            <tr>
                <td>@advogado.Nome</td>
                <td>@advogado.Senioridade</td>
                <td>@advogado.Estado</td>
                <td>
                    <button type="button"
                            class="btn btn-sm btn-primary btn-editar"
                            data-id="@advogado.Id">
                        <i class="fas fa-edit"></i>
                    </button>
                    <button type="button"
                            class="btn btn-sm btn-danger"
                            data-id="@advogado.Id"
                            onclick="AdvogadoViewModel_Confirmar(@advogado.Id)">
                        <i class="fas fa-trash-alt"></i>
                    </button>
                </td>
            </tr>
        }
    </tbody>
</table>

<div id="advogadoModal" class="modal fade" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Cadastro de Advogado</h5>
            </div>
            <div class="modal-body">
                <div id="formularioContainer">
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            var formUrl = '@Url.Action("Formulario", "Advogado")';
            var $modal = $('#advogadoModal');
            var $formContainer = $('#formularioContainer');

            //Lógica para ABRIR o modal para (NOVO CADASTRO)
            $('#btnNovoAdvogado').click(function (e) {
                e.preventDefault();

                $formContainer.html("Carregando formulário de cadastro...");
                $modal.modal('show');

                // Carrega o formulário vazio via AJAX (sem ID)
                $formContainer.load(formUrl, function(responseText, statusTxt, xhr) {
                    if (statusTxt != "success") {
                        $formContainer.html("Erro ao carregar o formulário. Tente recarregar a página.");
                    }
                });
            });

            // Lógica para ABRIR o modal para (EDIÇÃO)
            $('#tabelaAdvogados').on('click', '.btn-editar', function() {
                var advogadoId = $(this).data('id');

                $formContainer.html("Carregando formulário de edição...");
                $modal.modal('show');

                // Carrega o formulário via AJAX, passando o ID na query string
                $formContainer.load(formUrl + '?pIntId=' + advogadoId, function(responseText, statusTxt, xhr) {
                    if (statusTxt != "success") {
                        $formContainer.html("Erro ao carregar o formulário. Tente recarregar a página.");
                    }
                });
            });

            // Lógica para FECHAR o modal
            $modal.on('click', '[data-dismiss="modal"]', function (e) {
                e.preventDefault();
                $modal.modal('hide');
            });

            //Lógica para definir o temporizador das nofiticações (TempData)
            var $alert = $('.alert-success');
            if ($alert.length) {
                $alert.delay(3000) 
                    .fadeOut(500, function () { 
                        $(this).remove(); 
                    });
            }
        });
    </script>
}